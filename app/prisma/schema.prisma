// TabCall — Prisma schema (v2.0 PRD §9 + Phase 2 menu/billing/tip extensions)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Plan {
  STARTER
  FLAT
  FOUNDING
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}


enum PosType {
  NONE
  TOAST
  SQUARE
  CLOVER
}

enum StaffRole {
  // Phase-1 RBAC. Roles are ordered loosely by privilege. Existing
  // legacy STAFF rows are migrated to OWNER (they were the venue
  // creator from /api/signup) — STAFF stays in the enum so the
  // migration is non-destructive but is no longer assigned.
  OWNER
  MANAGER
  SERVER
  HOST
  VIEWER
  STAFF // legacy — do not assign new rows
}

enum StaffStatus {
  ACTIVE
  INVITED // sent magic link, never signed in
  SUSPENDED // soft-disabled; row retained for audit history
  DELETED // resigned / fired; soft-removed. Excluded from active lists,
  // table-assignment writes refuse, sessions invalidated via
  // sessionsValidAfter bump. Audit history + completed requests stay.
}

enum RequestType {
  DRINK
  // BILL is "ready for the check" — a signal to the server that the table
  // wants to close out. TabCall never touched the money; the POS settles.
  // Name kept because it is written into every historical row.
  BILL
  HELP
  REFILL
  // Guest is ready to order. Notifies the assigned server; it does NOT
  // submit anything to the POS.
  ORDER
  // Birthday, anniversary, engagement — the server gets a heads-up so the
  // room can react. Deliberately separate from HELP so it can be styled
  // and staffed differently.
  CELEBRATION
  // Clear or wipe the table.
  CLEAN
  // Napkins, cutlery, condiments — a runner can handle it without pulling
  // the server off another table.
  SUPPLIES
}

enum RequestStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  ESCALATED
}

// What the staff member actually did when resolving a request. Captured
// at the time of resolution so analytics can split "served on time" from
// "comped because we made them wait" from "couldn't help" etc. Required
// when transitioning a request to RESOLVED — the staff queue UI shows a
// small picker before flipping the status.
enum ResolutionAction {
  SERVED
  COMPED
  REFUSED
  ESCALATED
  NOT_ACTIONABLE
  OTHER
}

model Organization {
  id                    String             @id @default(cuid())
  name                  String
  plan                  Plan               @default(FOUNDING)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  // Stripe Billing snapshot — populated by customer.subscription.* webhooks.
  // Drives the "is the org current?" gate that hides paywalled features.
  subscriptionStatus    SubscriptionStatus @default(NONE)
  subscriptionPriceId   String?
  subscriptionPeriodEnd DateTime?
  trialEndsAt           DateTime?
  createdAt             DateTime           @default(now())
  venues                Venue[]
  members               OrgMember[]
}

model Venue {
  id                       String           @id @default(cuid())
  orgId                    String
  slug                     String           @unique
  name                     String
  address                  String?
  zipCode                  String?
  // E.164 phone number captured at signup. Used for SMS reservations
  // confirmations and as the manager's emergency contact. Format:
  // "+12125551234" (country dial code + national number, no spaces).
  phoneNumber              String?
  // ISO 3166-1 alpha-2 country code captured at signup (US, GB, MX, …).
  // Drives the signup phone-input default + tax routing per jurisdiction.
  country                  String?
  timezone                 String           @default("America/Chicago")
  posType                  PosType          @default(NONE)
  posWebhookUrl            String?
  googlePlaceId            String?
  // Compliance: when true, the first DRINK request on a fresh guest session
  // sets `idCheckRequired` on the request so staff see a coral "ID check"
  // badge before tapping Got it.
  requireIdOnFirstDrink    Boolean          @default(false)
  brandColor               String?
  logoUrl                  String?
  // Tier 3a: optional grouping tag for hierarchical filtering in the
  // multi-location operator console (e.g. "Texas locations only").
  regionTag                String?
  // Comma-separated extra email recipients for bad-rating alerts and
  // similar venue-level notifications. Empty = use OPERATOR_EMAILS only.
  alertEmails              String?
  // Per-shift kill switches. Manager can flip these from Settings to
  // pause a feature (kitchen slammed, no servers on the floor, etc.)
  // without losing existing data. Default true so new venues "just work".
  requestsEnabled          Boolean          @default(true)
  preorderEnabled          Boolean          @default(true)
  reservationsEnabled      Boolean          @default(true)
  // Optional guest-facing copy. Manager-editable from Settings; the
  // guest flow falls back to baked-in defaults when these are null.
  // Keep concise — these render inline in the QR landing and feedback
  // screen, so long blocks of text would push the action buttons off
  // a phone viewport.
  guestWelcomeMessage      String?          @db.Text
  guestConfirmationMessage String?          @db.Text
  reviewPrompt             String?          @db.Text
  // Onboarding feature toggles. Persists the user's choices from Step 4
  // of the wizard. Null means defaults (everything on). JSON shape:
  //   { qr_ordering: bool, qr_payments: bool, call_waiter: bool,
  //     reviews: bool, pos_integration: bool }
  enabledFeatures          Json?
  // Onboarding redesign (2026-05-20): free-text vertical classifier set
  // in wizard step 1 ("restaurant" | "cafe" | "bar" | ...). Was stored
  // client-only in localStorage previously; promoted to a column so
  // per-vertical analytics + features can query it.
  venueType                String?
  // Server-persisted wizard state — { currentStep, completedSteps[], solo }.
  // Lets a user resume onboarding on a different device or after
  // clearing browser data. The shape is validated client-side; the
  // column is permissive so we can extend without a migration.
  onboardingState          Json?
  // Set when the user explicitly clicks "Launch venue" on the final
  // step. Null = wizard not yet finished → dashboard shows a resume
  // banner. Backfilled to createdAt for legacy venues that already had
  // brandColor + a real zipCode before this column existed.
  onboardingCompletedAt    DateTime?
  createdAt                DateTime         @default(now())
  org                      Organization     @relation(fields: [orgId], references: [id])
  tables                   Table[]
  staff                    StaffMember[]
  sessions                 GuestSession[]
  requests                 Request[]
  feedback                 FeedbackReport[]
  menuCategories           MenuCategory[]
  menuItems                MenuItem[]
  reservations             Reservation[]
  waitlist                 Waitlist[]
  specials                 VenueSpecial[]
  auditLog                 AuditLog[]
  // Spec-verbatim Guest Commerce Module (parallel schema; coexists with
  // VenueSpecial). See migration
  // 20260512_guest_commerce_v2 for the trade-offs.
  orders                   Order[]
  promotions               Promotion[]
  wishlists                Wishlist[]
  menuItemPairings         MenuItemPairing[]
  posSyncLogs              PosSyncLog[]
  venueBranding            VenueBranding?
  posIntegration           PosIntegration?
  gbpConnection            GbpConnection?
  googleReviews            GoogleReview[]
  guestContacts            GuestContact[]
  guestVisits              GuestVisit[]
  campaigns                Campaign[]

  @@index([orgId])
}

// Time-windowed promotions a venue surfaces to guests on the QR landing.
// "Happy hour", "$5 well drinks until 7", "tonight's wine flight", etc.
// Both window fields nullable so an "always-on" special is possible
// (e.g. signature cocktail, weekly recurring on the manager's end).
model VenueSpecial {
  id          String    @id @default(cuid())
  venueId     String
  title       String
  description String?
  // Optional headline price. Stored in cents so analytics can compute
  // discount-vs-rack later. Null = "see menu" or "ask staff".
  priceCents  Int?
  // Active window. Null/null = always shown when active.
  startsAt    DateTime?
  endsAt      DateTime?
  // Soft toggle so a manager can pull a special without deleting it.
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  venue       Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, active, startsAt])
  @@index([venueId, endsAt])
}

// Phase 2: menu management. Bills are still authored as JSON line items on
// GuestSession (kept for flexibility — comps, custom drinks, etc.) but the
// menu drives the staff "add to tab" picker and the guest browse/pre-order
// experience.
model MenuCategory {
  id        String     @id @default(cuid())
  venueId   String
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items     MenuItem[]

  @@index([venueId])
}

model MenuItem {
  id             String          @id @default(cuid())
  venueId        String
  categoryId     String?
  name           String
  description    String?
  priceCents     Int
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  sortOrder      Int             @default(0)
  imageUrl       String?
  // Drinks/alcohol → trip the same first-drink ID-check flag a DRINK
  // request would. Lets a venue mark a soda as non-alcoholic so a refill
  // doesn't ask for ID.
  ageRestricted  Boolean         @default(false)
  // Discovery tags ("light", "bold", "sweet", "filling", "drink"). Drives
  // the "what are you in the mood for?" prompts deterministically — the
  // venue decides what a dish is, not a model guessing from its name.
  tags           String[]        @default([])
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  venue          Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category       MenuCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  promotionLinks PromotionItem[]
  wishlistItems  WishlistItem[]
  pairingsFrom   MenuItemPairing[] @relation("PairingSource")
  pairingsTo     MenuItemPairing[] @relation("PairingTarget")

  @@index([venueId, isActive])
  @@index([venueId, isFeatured])
  @@index([categoryId])
}

model Table {
  id           String            @id @default(cuid())
  venueId      String
  label        String
  qrToken      String            @unique
  zone         String?
  createdAt    DateTime          @default(now())
  venue        Venue             @relation(fields: [venueId], references: [id])
  sessions     GuestSession[]
  requests     Request[]
  assignments  TableAssignment[]
  reservations Reservation[]
  // Guest Commerce Module back-refs.
  orders       Order[]
  wishlists    Wishlist[]

  @@unique([venueId, label])
  @@index([venueId])
}

model StaffMember {
  id                 String        @id @default(cuid())
  venueId            String
  name               String
  email              String        @unique
  role               StaffRole     @default(SERVER)
  status             StaffStatus   @default(ACTIVE)
  fcmToken           String?
  createdAt          DateTime      @default(now())
  // Last successful sign-in via /api/auth/callback. Surfaces on the
  // People page so managers can spot stale accounts that should be
  // suspended.
  lastSeenAt         DateTime?
  // Lower bound on JWT iat that's considered valid. "Sign out everywhere"
  // bumps this to NOW(); any cached session JWT issued before this
  // timestamp gets rejected at verifySessionToken. Nullable: rows
  // pre-dating the feature retain unrestricted token TTL.
  sessionsValidAfter DateTime?
  // Free-text section assignment (e.g. "Patio", "Bar", "Floor 2"). Used
  // alongside TableAssignment for venues that group staff by zone rather
  // than per-table. Pure metadata — display + filter only.
  section            String?
  // The three fields a GUEST may see. Everything else on this row is
  // internal: `name` can be a legal name, `email` is a credential, and
  // neither belongs on a stranger's phone. displayName is the first name
  // the server actually goes by on the floor.
  displayName        String?
  photoUrl           String?
  // Optional per-server greeting. Falls back to the venue default, then to
  // a TabCall default — a server is never required to write one, and the
  // venue owner can overwrite it.
  welcomeMessage     String?       @db.Text
  // Optional password sign-in. Magic-link remains the default path;
  // password is an opt-in upgrade. Nullable so every existing row
  // keeps working unchanged. passwordChangedAt mirrors the
  // sessionsValidAfter pattern — rotating the password invalidates
  // every JWT minted before the change.
  passwordHash       String?
  passwordChangedAt  DateTime?
  // Stamped on first successful magic-link sign-in. Password sign-in
  // refuses to mint a session until this is set. Null means the user
  // signed up but never clicked their magic link.
  emailVerifiedAt    DateTime?
  // Self-referential audit: who invited this row, who suspended it.
  // Both nullable so the original venue OWNER (created by signup)
  // doesn't need a phantom inviter.
  invitedById        String?
  invitedBy          StaffMember?  @relation("StaffInvites", fields: [invitedById], references: [id])
  invitesSent        StaffMember[] @relation("StaffInvites")
  suspendedAt        DateTime?
  suspendedById      String?
  suspendedBy        StaffMember?  @relation("StaffSuspends", fields: [suspendedById], references: [id])
  suspended          StaffMember[] @relation("StaffSuspends")

  venue          Venue                @relation(fields: [venueId], references: [id])
  ackedRequests  Request[]            @relation("AcknowledgedBy")
  assignments    TableAssignment[]
  passwordResets PasswordResetToken[]
  wearDevices    WearDevice[]
  identities     AuthIdentity[]

  @@index([venueId])
  @@index([venueId, status])
}

// Federated sign-in identities (OAuth/OIDC). One row per (provider,
// external-subject) → the StaffMember it authenticates. Dedicated table
// (not columns on StaffMember) so the hot staff row stays lean and a
// second provider — Apple later — is a row insert, not a migration.
// Google's `email_verified` claim makes auto-linking an existing
// email-matched staff row safe; the row records the email at link time
// for audit.
model AuthIdentity {
  id          String      @id @default(cuid())
  staffId     String
  staff       StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  provider    String // "google" (Apple slots in later)
  subject     String // provider's stable user id (Google `sub`)
  email       String // email at link time — audit only, not a lookup key
  createdAt   DateTime    @default(now())
  lastLoginAt DateTime?

  @@unique([provider, subject])
  @@index([staffId])
}

// =====================================================================
// Wearables — paired smartwatches for floor staff (see sdk/tabcall-wear)
// =====================================================================

// A watch (or other wearable) paired to one staff member. Watches
// authenticate with a long-lived bearer JWT (kind:"wear") that names
// this row; verification refuses tokens minted before tokenIssuedAt
// (rotated on re-pair) or for revoked/suspended rows, so "Revoke" in
// the staff console kills a lost watch instantly.
model WearDevice {
  id            String      @id @default(cuid())
  staffId       String
  staff         StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  // Human label shown in the staff console ("Maya's Galaxy Watch").
  name          String
  // "wearos" | "watchos" | "tizen" | "fitbit" | ... — free text so a new
  // platform doesn't need a migration.
  platform      String
  // Push token registered by the watch app itself (FCM on Wear OS).
  // Separate from StaffMember.fcmToken (the phone PWA) so pairing a
  // watch doesn't clobber phone push.
  fcmToken      String?
  // Lower bound on accepted JWT iat for this device.
  tokenIssuedAt DateTime    @default(now())
  revokedAt     DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime    @default(now())

  @@index([staffId])
}

// Single-use, short-TTL numeric codes bridging phone → watch pairing.
// The staff member generates a code on their (already authenticated)
// phone; the watch claims it with no other credentials. Stored hashed
// so a DB read can't mint watch sessions.
model WearPairCode {
  id        String    @id @default(cuid())
  staffId   String
  codeHash  String    @unique
  expiresAt DateTime
  claimedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([staffId, createdAt])
  @@index([expiresAt])
}

// Append-only audit trail for sensitive admin actions. Today we emit
// on staff invites/role-changes/suspends/removals so a manager can
// reconstruct who promoted which bartender to manager three weeks
// ago. Other surfaces (menu, billing) can plug in later by calling
// the same `audit()` helper.
model AuditLog {
  id         String   @id @default(cuid())
  venueId    String
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  // Who did it. We store the email at action-time rather than an FK
  // so the entry survives the actor being removed from the venue.
  actorEmail String
  actorRole  String
  // Dot-namespaced action verb, e.g. "staff.invited",
  // "staff.role_changed", "staff.suspended", "staff.removed".
  action     String
  targetType String?
  targetId   String?
  // Free-form structured context: { fromRole, toRole, email, ... }.
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([venueId, createdAt])
  @@index([venueId, action])
}

// Many-to-many: staff cover tables. A staff member can cover multiple
// tables; a table can be covered by multiple staff (e.g. bartender +
// floater both cover the bar). When a request lands on an assigned table,
// the realtime emit also fires to staff:{id} rooms for those staff.
model TableAssignment {
  tableId       String
  staffMemberId String
  createdAt     DateTime    @default(now())
  table         Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  staff         StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@id([tableId, staffMemberId])
  @@index([staffMemberId])
}

model GuestSession {
  id             String           @id @default(cuid())
  venueId        String
  tableId        String
  sessionToken   String           @unique
  lineItems      Json             @default("[]")
  paidAt         DateTime?
  // Tier 3c: optional link to a returning guest's profile. Set when the
  // guest identified via /api/v/[slug]/profile/identify before paying.
  guestProfileId String?
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  venue          Venue            @relation(fields: [venueId], references: [id])
  table          Table            @relation(fields: [tableId], references: [id])
  requests       Request[]
  feedback       FeedbackReport[]
  guestProfile   GuestProfile?    @relation(fields: [guestProfileId], references: [id])
  // Guest Commerce Module back-refs (V2 schema).
  orders         Order[]
  wishlist       Wishlist?

  @@index([venueId, tableId])
  @@index([expiresAt])
  @@index([guestProfileId])
}

// Tip pooling: aggregate tips over a period and distribute across staff
// who worked. We do NOT touch funds — we record splits and the manager
// settles via cash/payroll. Stripe Connect doesn't support arbitrary
// venue → staff transfers without a marketplace marketplace setup.


model Request {
  id               String            @id @default(cuid())
  venueId          String
  tableId          String
  sessionId        String
  type             RequestType
  status           RequestStatus     @default(PENDING)
  note             String?
  // For DRINK requests on a fresh session at compliance-flagged venues:
  // staff must acknowledge having checked ID before tapping Got it.
  idCheckRequired  Boolean           @default(false)
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  // What the staff member actually did, captured at resolve-time. Null
  // for requests that were resolved by older versions of the app
  // before this column existed.
  resolutionAction ResolutionAction?
  resolutionNote   String?
  escalatedAt      DateTime?
  // When the request actually reached a destination, and which one. Split
  // from createdAt because "we recorded it" and "a human could see it" are
  // different moments, and only the second one is a service-time promise
  // we can honestly report on.
  routedAt         DateTime?
  routingChannel   String?
  createdAt        DateTime          @default(now())
  venue            Venue             @relation(fields: [venueId], references: [id])
  table            Table             @relation(fields: [tableId], references: [id])
  session          GuestSession      @relation(fields: [sessionId], references: [id])
  acknowledgedBy   StaffMember?      @relation("AcknowledgedBy", fields: [acknowledgedById], references: [id])

  @@index([venueId, status])
  @@index([sessionId])
}

// Single-use enforcement for magic-link tokens. The link JWT carries a
// `jti` claim; the callback inserts the jti here on first redemption.
// On subsequent attempts the unique constraint blocks a fresh session.
// Rows older than 24h can be GC'd by a cron — token TTL is 15 minutes.
model LinkTokenUse {
  jti     String   @id
  staffId String
  usedAt  DateTime @default(now())

  @@index([usedAt])
}

// Single-use, time-bounded tokens for the password-reset flow.
// Distinct from magic-link auth: a reset token is one-way (no session
// is minted by clicking it), and consuming it bumps the staff row's
// sessionsValidAfter so any older logged-in devices are signed out.
// Tokens are stored as their sha256 hash (`tokenHash`) so a database
// dump can't be used to mint replacements. Plaintext token never
// leaves the email + the user's browser.
model PasswordResetToken {
  id        String      @id @default(cuid())
  staffId   String
  tokenHash String      @unique
  // 1-hour expiry. Cron job cleans up rows past expiresAt + grace
  // period (~24h) for forensics.
  expiresAt DateTime
  // Set on first successful POST to /api/auth/reset-password. The
  // unique tokenHash prevents replay attacks via the DB constraint;
  // usedAt is informational + lets us answer "did this user reset
  // recently?" in audit reports.
  usedAt    DateTime?
  // Where the request came from. Useful when investigating "I didn't
  // ask for a reset" support tickets.
  requestIp String?
  createdAt DateTime    @default(now())
  staff     StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, createdAt])
  @@index([expiresAt])
}

// Single-use enforcement + audit log for "Comp this round" actions
// triggered from the AI bad-rating email. The email contains a signed
// JWT with a jti; applying the comp inserts the jti here so the link
// can't be replayed (e.g. forwarded to another manager).

// Stripe webhook idempotency: Stripe may deliver the same event multiple
// times. We insert by event ID; the unique constraint dedupes retries.
// `processedAt` lets us detect events that crashed mid-processing.
model WebhookEvent {
  id          String    @id // Stripe event ID, e.g. evt_1Abc...
  type        String
  payload     Json
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@index([type, receivedAt])
}

model FeedbackReport {
  id                       String        @id @default(cuid())
  venueId                  String
  // One feedback per session. The route already enforces this via a
  // findFirst+throw, but the unique constraint is the source of truth
  // and closes the concurrent-submit race window.
  sessionId                String        @unique
  // 1-5, unchanged. The guest picks one of four faces; lib/feedback maps
  // them onto this scale so existing reports, averages and the Google
  // review threshold keep meaning the same thing.
  rating                   Int
  // Derived from rating at write time so queries don't re-derive it and
  // drift: NEGATIVE | NEUTRAL | POSITIVE.
  sentiment                String?
  // Set only when the guest explicitly asked for a manager. This is what
  // raises a service-recovery alert; a bad rating alone does not, because
  // "I'd rather just leave" is a valid answer.
  managerRecoveryRequested Boolean       @default(false)
  recoveryResolvedAt       DateTime?
  recoveryResolvedById     String?
  // Set only if the guest later chose to leave a phone number. Feedback is
  // submitted anonymously and stays that way unless they opt in.
  guestContactId           String?
  note                     String?
  // Reviews suite R2: employee + shift attribution, stamped at submit
  // time from the session's service history (who actually acknowledged
  // requests at this table) and the venue's timezone. Name denormalized
  // so attribution survives staff churn/deletion.
  servedByStaffId          String?
  servedByName             String?
  // "morning" | "afternoon" | "evening" | "late" in the VENUE's tz.
  shiftBucket              String?
  // AI classification (PRD v2.0 F4 — bad-review intercept)
  aiCategory               String? // service_speed | drink_quality | staff_attitude | wait_time | food | noise | other
  aiSuggestion             String?
  aiServerName             String?
  seenByMgr                Boolean       @default(false)
  // Manager-flagged for follow-up (escalation, refund, legal, etc).
  // Distinct from seenByMgr: a review can be seen AND flagged. Reviews
  // page filters on this column independently.
  flagged                  Boolean       @default(false)
  flaggedAt                DateTime?
  createdAt                DateTime      @default(now())
  venue                    Venue         @relation(fields: [venueId], references: [id])
  session                  GuestSession  @relation(fields: [sessionId], references: [id])
  guestContact             GuestContact? @relation(fields: [guestContactId], references: [id], onDelete: SetNull)
  tags                     FeedbackTag[]

  @@index([venueId, createdAt])
  @@index([venueId, servedByStaffId])
  // The manager queue: open recovery requests, newest first.
  @@index([venueId, managerRecoveryRequested, recoveryResolvedAt])
}

// =====================================================================
// Reviews & reputation suite (2026-07) — Google Business Profile
// =====================================================================

enum GbpConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

// One Google Business Profile connection per venue. Created by the
// owner via a venue-level OAuth consent (offline access, business.manage
// scope) — a SEPARATE grant from the sign-in OAuth, though it reuses the
// same Google Cloud client. The refresh token is AES-256-GCM encrypted
// via lib/pos/crypto (same posture as PosIntegration credentials): the
// frontend never sees it; only the sync/reply code decrypts at call time.
model GbpConnection {
  id                    String              @id @default(cuid())
  venueId               String              @unique
  venue                 Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  // Google account that granted access — display + support only.
  googleEmail           String?
  // GBP resource names: "accounts/{id}" and "locations/{id}". Location
  // is bound by the owner from a picker after consent.
  gbpAccountName        String?
  gbpLocationName       String?
  // Human label of the bound location ("TabCall Taproom — Austin").
  locationTitle         String?
  encryptedRefreshToken String?             @db.Text
  status                GbpConnectionStatus @default(PENDING)
  lastSyncAt            DateTime?
  lastError             String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status])
}

// Google reviews mirrored locally by the sync cron so the inbox, reports
// and multi-location comparison read fast without hitting the GBP API.
// gbpReviewName is the API resource name — the natural idempotency key.
model GoogleReview {
  id               String    @id @default(cuid())
  venueId          String
  venue            Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  gbpReviewName    String    @unique
  starRating       Int
  comment          String?   @db.Text
  reviewerName     String?
  reviewerPhotoUrl String?
  gbpCreatedAt     DateTime
  gbpUpdatedAt     DateTime?
  // Reply state. replySource distinguishes replies posted through
  // TabCall from ones that already existed on GBP.
  replyText        String?   @db.Text
  repliedAt        DateTime?
  replySource      String?
  // Latest AI-drafted reply awaiting owner review (R4). Cleared on post.
  aiDraft          String?   @db.Text
  seenByMgr        Boolean   @default(false)
  syncedAt         DateTime  @default(now())

  @@index([venueId, gbpCreatedAt])
  @@index([venueId, seenByMgr])
  @@index([venueId, repliedAt])
}

// =====================================================================
// Tier 3 — Multi-location, reservations, loyalty, benchmarking
// =====================================================================

// --- Tier 3a: Multi-location operator console (OrgMember) ---

enum OrgMemberRole {
  OWNER
  ADMIN
  VIEWER
}

model OrgMember {
  id        String        @id @default(cuid())
  orgId     String
  email     String
  role      OrgMemberRole @default(VIEWER)
  createdAt DateTime      @default(now())
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
  @@index([email])
}

// --- Tier 3b: Reservations + waitlist (Reservation, Waitlist, enums) ---

enum ReservationStatus {
  PENDING
  ARRIVED
  SEATED
  NO_SHOW
  CANCELED
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  SEATED
  ABANDONED
}

// DEPRECATED — reservations were removed from the product. Booking a table
// weeks out is a different job from what TabCall does, which is the guest's
// experience once they're sitting down.
//
// The table is intentionally still here: this environment points at a local
// database, so production row counts could not be verified, and dropping a
// table blind is not a trade worth making. Drop it in a follow-up once
// production is confirmed empty.
model Reservation {
  id         String            @id @default(cuid())
  venueId    String
  tableId    String?
  zone       String?
  partySize  Int
  startsAt   DateTime
  endsAt     DateTime
  guestName  String
  guestPhone String
  status     ReservationStatus @default(PENDING)
  notes      String?
  arrivedAt  DateTime?
  seatedAt   DateTime?
  // Short code the guest gets in their SMS — used to look up / cancel
  // their booking from the public page without exposing the row id.
  guestCode  String            @default(cuid())
  createdAt  DateTime          @default(now())
  venue      Venue             @relation(fields: [venueId], references: [id])
  table      Table?            @relation(fields: [tableId], references: [id])

  @@index([venueId, startsAt])
  @@index([guestPhone])
}

model Waitlist {
  id            String         @id @default(cuid())
  venueId       String
  partySize     Int
  guestName     String
  guestPhone    String
  quotedWaitMin Int
  joinedAt      DateTime       @default(now())
  notifiedAt    DateTime?
  seatedAt      DateTime?
  status        WaitlistStatus @default(WAITING)
  venue         Venue          @relation(fields: [venueId], references: [id])

  @@index([venueId, joinedAt])
}

// --- Tier 3c: Loyalty (GuestProfile + OTP) ---

model GuestProfile {
  id                     String         @id @default(cuid())
  phone                  String         @unique
  displayName            String?
  email                  String?        @unique
  // Per-venue points balance: { [venueId]: integer }. Mutated under
  // row-level lock during webhook processing so concurrent payments
  // don't race.
  loyaltyPointsByVenueId Json           @default("{}")
  preferences            Json           @default("{}")
  createdAt              DateTime       @default(now())
  sessions               GuestSession[]
  notes                  GuestNote[]
}

// Tier 3e: free-text notes pinned to a regular for staff handoff.
// Authored per-venue so a regular's note at Bar A doesn't leak to Bar B
// even if they have the same phone. Soft-delete via `deletedAt` so an
// accidental delete is recoverable.
model GuestNote {
  id             String       @id @default(cuid())
  guestProfileId String
  venueId        String
  authorStaffId  String?
  authorName     String // denormalized for display after staff churn
  body           String       @db.Text
  pinned         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  guestProfile   GuestProfile @relation(fields: [guestProfileId], references: [id], onDelete: Cascade)

  @@index([guestProfileId, venueId])
  @@index([venueId, createdAt])
}

// 6-digit OTPs for phone-based guest identification. SHA-256 hashed so
// the table doesn't store plaintext codes. 5-minute TTL; max 5 attempts
// per row.
model GuestProfileOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
}

// --- Tier 3d: Benchmarking (BenchmarkSnapshot) ---

model BenchmarkSnapshot {
  id          String   @id @default(cuid())
  date        DateTime
  // Stable hash of the segmentJson for unique-key purposes (Prisma
  // doesn't reliably support unique on Json). Compute via sha256 of
  // sorted-key stringified segmentJson.
  segmentKey  String
  segmentJson Json
  metric      String
  p25         Float
  p50         Float
  p75         Float
  p90         Float
  // K-anonymity guard: never expose values from segments where this is
  // below 5. The cron job refuses to write rows with sampleCount < 5.
  sampleCount Int
  createdAt   DateTime @default(now())

  @@unique([date, metric, segmentKey])
  @@index([date, metric])
}

// Cross-venue, platform-scoped audit log. Existing AuditLog requires a
// venueId; this table records actions that aren't bound to one venue
// (operator impersonation, org-level edits, broadcast emails, plan
// flips). Append-only. Backfill TODO: wire org-level operator routes
// to also emit here.
model OperatorAuditLog {
  id         String   @id @default(cuid())
  // Who did it — operator email at action time. Lookups by email
  // survive PlatformAdmin row deletion.
  actorEmail String
  action     String // dot-namespaced, e.g. "operator.impersonate.start"
  targetType String? // "Venue", "Organization", "StaffMember", ...
  targetId   String?
  // Free-form structured context: { venueSlug, asStaffEmail, reason, … }.
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([actorEmail, createdAt])
  @@index([action, createdAt])
}

// Platform-staff allowlist managed in-app. Two sources of truth for
// "is this user a TabCall founder?":
//   1. OPERATOR_EMAILS env (legacy, still respected — survives DB outage)
//   2. This table (managed via /operator/admins UI)
// `isPlatformStaffAsync()` checks both; `isPlatformStaff()` (sync) is
// env-only for tight render paths.
//
// Suspending an admin keeps the row for audit history; removing wipes
// it. Last-admin protection lives in the API route.
model PlatformAdmin {
  id                String          @id @default(cuid())
  email             String          @unique
  name              String?
  notes             String?
  // Password-based sign-in for the TabCall super-admin console.
  // Magic-link auth remains the only path for StaffMember rows;
  // password auth is platform-admin-only and gates /admin/login.
  passwordHash      String?
  passwordChangedAt DateTime?
  // Self-references for invite/suspend audit attribution.
  addedById         String?
  addedBy           PlatformAdmin?  @relation("AdminAddedBy", fields: [addedById], references: [id])
  added             PlatformAdmin[] @relation("AdminAddedBy")
  suspendedAt       DateTime?
  suspendedById     String?
  suspendedBy       PlatformAdmin?  @relation("AdminSuspendedBy", fields: [suspendedById], references: [id])
  suspended         PlatformAdmin[] @relation("AdminSuspendedBy")
  lastSeenAt        DateTime?
  createdAt         DateTime        @default(now())

  @@index([email])
}

// =====================================================================
// Guest Commerce Module — spec-verbatim parallel schema
// =====================================================================
//
// Order / OrderItem for the guest ordering flow. The Bill, BillItem and
// split models that used to sit alongside them were removed with guest
// payments — they tracked amounts paid, due, taxed and tipped, none of
// which TabCall handles any more. A tab now lives entirely in
// GuestSession.lineItems.

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum OrderItemStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PromotionType {
  HAPPY_HOUR
  BUSINESS_LUNCH
  BANNER
  LIMITED_TIME_ITEM
  NEW_ITEM
  DISCOUNT_HIGHLIGHT
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

// Why one menu item is being suggested alongside another.
//
// The relationship IS the copy. A guest is shown "Pairs well with" or
// "Goes down well after" depending on which of these the venue chose, so
// these values are not interchangeable labels — each one produces a
// different sentence in front of a guest.
enum PairingRelationship {
  PAIRS_WITH
  POPULAR_WITH
  COMPLETE_MEAL
  RECOMMENDED_DRINK
  RECOMMENDED_DESSERT
}

enum WishlistStatus {
  ACTIVE
  CONVERTED
  CANCELLED
}

enum PosIntegrationStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

model Order {
  id             String        @id @default(cuid())
  venueId        String
  tableId        String?
  guestSessionId String?
  status         OrderStatus   @default(NEW)
  subtotalCents  Int
  taxCents       Int           @default(0)
  serviceCents   Int           @default(0)
  tipCents       Int           @default(0)
  totalCents     Int
  posReference   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  venue          Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  table          Table?        @relation(fields: [tableId], references: [id], onDelete: SetNull)
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  items          OrderItem[]

  @@index([venueId, status, createdAt])
  @@index([guestSessionId])
}

model OrderItem {
  id           String          @id @default(cuid())
  orderId      String
  menuItemId   String?
  nameSnapshot String
  priceCents   Int
  quantity     Int             @default(1)
  notes        String?
  status       OrderItemStatus @default(NEW)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem     MenuItem?       @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Promotion {
  id             String          @id @default(cuid())
  venueId        String
  title          String
  description    String?
  type           PromotionType
  bannerImageUrl String?
  startsAt       DateTime?
  endsAt         DateTime?
  status         PromotionStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  venue          Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  items          PromotionItem[]

  @@index([venueId, status, startsAt])
}

model PromotionItem {
  id          String    @id @default(cuid())
  promotionId String
  menuItemId  String
  createdAt   DateTime  @default(now())
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([promotionId, menuItemId])
  @@index([menuItemId])
}

model Wishlist {
  id                String         @id @default(cuid())
  venueId           String
  tableId           String?
  guestSessionId    String         @unique
  status            WishlistStatus @default(ACTIVE)
  sharedWithStaffAt DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  venue             Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  table             Table?         @relation(fields: [tableId], references: [id], onDelete: SetNull)
  guestSession      GuestSession   @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  items             WishlistItem[]

  @@index([venueId, status])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  menuItemId String
  quantity   Int      @default(1)
  notes      String?
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, menuItemId])
}

// "Pairs well with" — one venue-authored suggestion from one dish to
// another.
//
// AUTHORED, NEVER INFERRED. TabCall has no basket, no bill and no
// transaction history, so it cannot know what actually gets ordered
// together; anything it claimed about that would be invented. A chef
// knows which wine goes with the pork, and this is where they say so.
//
// The pair is unique, so a venue can't stack three copies of the same
// recommendation on one dish. Cascades from every side: deleting a venue
// or either dish removes the suggestion rather than leaving a row
// pointing at nothing.
model MenuItemPairing {
  id           String              @id @default(cuid())
  venueId      String
  // The dish a guest is looking at or has just saved.
  menuItemId   String
  // What the venue suggests alongside it.
  suggestedId  String
  relationship PairingRelationship @default(PAIRS_WITH)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())

  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  menuItem  MenuItem @relation("PairingSource", fields: [menuItemId], references: [id], onDelete: Cascade)
  suggested MenuItem @relation("PairingTarget", fields: [suggestedId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, suggestedId])
  @@index([venueId])
  @@index([menuItemId])
}

model VenueBranding {
  id             String   @id @default(cuid())
  venueId        String   @unique
  logoUrl        String?
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  fontFamily     String?
  welcomeMessage String?
  bannerImageUrl String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  venue          Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
}

model PosIntegration {
  id                   String               @id @default(cuid())
  venueId              String               @unique
  // "NONE" | "TOAST" | "SQUARE" | "CLOVER". Kept loose-typed so adding a
  // provider doesn't require a Prisma migration.
  provider             String
  status               PosIntegrationStatus @default(PENDING)
  // Encrypted blob — never read by frontend. The lib/pos/* abstraction
  // is the only thing that decrypts at request time.
  encryptedCredentials String?              @db.Text
  lastSyncAt           DateTime?
  lastError            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  venue                Venue                @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([provider, status])
}

model PosSyncLog {
  id                  String   @id @default(cuid())
  venueId             String
  provider            String
  // Dot-namespaced verb: "menu.sync", "order.send", "order.update_status",
  // "bill.fetch", "bill.mark_paid".
  action              String
  // "success" | "error"
  status              String
  // Never include credentials in these. The lib/pos/* helpers strip
  // anything matching /token|secret|password|apiKey|api_key/i before
  // writing.
  requestPayloadSafe  Json?
  responsePayloadSafe Json?
  errorMessage        String?
  createdAt           DateTime @default(now())
  venue               Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, createdAt])
}

// ----------------------------------------------------------------------
// Guest relationship
//
// A guest who leaves a phone number is giving it to ONE venue. Consent is
// given to that venue, the venue is the data controller, and a guest who
// opts out of one has not opted out of the others. So contacts are keyed
// on (venueId, phone) rather than on phone alone.
//
// This is deliberately separate from GuestProfile, which backs the Pro
// "Regulars" feature and is a cross-venue identity the guest opts into by
// verifying an OTP. Different purpose, different consent, different blast
// radius if either is ever breached.
// ----------------------------------------------------------------------

enum MarketingConsentStatus {
  // Never asked, or asked and declined the checkbox. NOT marketable.
  PENDING
  SUBSCRIBED
  UNSUBSCRIBED
}

model GuestContact {
  id          String   @id @default(cuid())
  venueId     String
  // E.164. Never rendered to floor staff — see lib/guest-contacts.
  phone       String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  venue              Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  consents           MarketingConsent[]
  visits             GuestVisit[]
  feedback           FeedbackReport[]
  campaignRecipients CampaignRecipient[]

  // One record per phone per venue. The same number at two venues is two
  // rows on purpose: two relationships, two consent decisions.
  @@unique([venueId, phone])
  @@index([venueId, lastSeenAt])
}

model MarketingConsent {
  id                 String                 @id @default(cuid())
  guestContactId     String
  venueId            String
  status             MarketingConsentStatus @default(PENDING)
  // The EXACT wording shown when they ticked the box. If the wording
  // changes, old consent doesn't silently cover the new terms — which is
  // the whole point of keeping a version rather than a boolean.
  consentTextVersion String?
  // Where it came from: "post_visit_feedback", "import", "admin".
  consentSource      String?
  consentedAt        DateTime?
  optedOutAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  guestContact GuestContact @relation(fields: [guestContactId], references: [id], onDelete: Cascade)

  @@index([venueId, status])
  @@index([guestContactId])
}

model GuestVisit {
  id               String    @id @default(cuid())
  venueId          String
  tableId          String?
  guestSessionId   String    @unique
  // Null until (and unless) the guest leaves a number. Most visits stay
  // anonymous, and that is a success state, not a gap.
  guestContactId   String?
  assignedServerId String?
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  rating           Int?
  createdAt        DateTime  @default(now())

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  guestContact GuestContact? @relation(fields: [guestContactId], references: [id], onDelete: SetNull)

  @@index([venueId, startedAt])
  @@index([guestContactId])
}

model FeedbackTag {
  id         String   @id @default(cuid())
  feedbackId String
  tag        String
  createdAt  DateTime @default(now())

  feedback FeedbackReport @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@unique([feedbackId, tag])
  @@index([tag])
}

// ----------------------------------------------------------------------
// Campaigns
//
// The management layer is real and persists. Whether anything is actually
// DELIVERED depends on a messaging provider being configured; without one
// a campaign can be composed and scheduled but never reports as sent.
// See lib/campaigns — nothing here pretends a message went out.
// ----------------------------------------------------------------------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  FAILED
  CANCELED
}

enum CampaignAudience {
  ALL_SUBSCRIBED
  VISITED_LAST_30_DAYS
  RETURNING_GUESTS
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

model Campaign {
  id           String           @id @default(cuid())
  venueId      String
  name         String
  message      String           @db.Text
  audienceType CampaignAudience @default(ALL_SUBSCRIBED)
  status       CampaignStatus   @default(DRAFT)
  scheduledAt  DateTime?
  sentAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  venue      Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  recipients CampaignRecipient[]

  @@index([venueId, status])
}

model CampaignRecipient {
  id             String                  @id @default(cuid())
  campaignId     String
  guestContactId String
  status         CampaignRecipientStatus @default(PENDING)
  deliveredAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime                @default(now())

  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  guestContact GuestContact @relation(fields: [guestContactId], references: [id], onDelete: Cascade)

  // One row per guest per campaign — the database, not application code,
  // is what guarantees nobody gets the same campaign twice.
  @@unique([campaignId, guestContactId])
  @@index([campaignId, status])
}
